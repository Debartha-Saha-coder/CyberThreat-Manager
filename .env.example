# ============================================================
# Cyber Threat Intelligence Platform — Environment Variables
# ============================================================

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=true

# Database
DATABASE_URL=sqlite:///./hackmetrix.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/hackmetrix

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# External Threat Intelligence API Keys (leave blank if not configured)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=
URLHAUS_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Scanning Limits
MAX_RESPONSE_SIZE_BYTES=5242880
SCAN_TIMEOUT_SECONDS=30
MAX_REDIRECTS=5

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Optional Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Admin
ADMIN_EMAIL=admin@hackmetrix.local
ADMIN_PASSWORD=change-this-admin-password
